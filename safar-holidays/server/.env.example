# Copy this file to .env and change the values.
# Every setting is optional: the app runs with the defaults shown here.

# Port the API listens on
PORT=4000

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=7d

# Where the SQLite database file is stored (relative to the server folder)
DB_PATH=data/travel.db

# Address of the React app during development (for CORS)
CLIENT_ORIGIN=http://localhost:5173
